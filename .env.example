# ── Paths ──────────────────────────────────────────────────────────────
# Host folder with the photo library (mounted read-only at /photos).
# On Umbrel find the disk mountpoint with `df -h` / `lsblk`.
PHOTO_ROOT=/media/hdd16tb/Photos

# Host port for the dashboard/API.
HOST_PORT=8765

# uid/gid the container runs as. Must be able to read PHOTO_ROOT and write
# ./database ./config ./logs. Umbrel default user is 1000:1000.
PUID=1000
PGID=1000

# Timezone used by the upload window.
TZ=Europe/Rome

# ── Files ──────────────────────────────────────────────────────────────
# Default whitelist: jpg, jpeg, heic, png, mp4, mov
# RAW (arw, cr2, cr3, nef, raf, orf, rw2, dng) disabled by default.
INCLUDE_RAW=false
# Comma separated, e.g. "gif,webp,m4v"
EXTRA_EXTENSIONS=
EXCLUDE_EXTENSIONS=

# A file is processed only after size/mtime are unchanged for this long
# (protects files still being copied to the disk).
STABILITY_WINDOW_SECONDS=30
HASH_CONCURRENCY=2

# Full rescan as a safety net for missed watcher events (0 = only at startup).
RESCAN_INTERVAL_MINUTES=360
WATCH_ENABLED=true
# Use polling if inotify does not work (network shares, some USB/NTFS setups).
WATCH_POLLING=false
WATCH_POLL_INTERVAL_SECONDS=30

# ── Google Photos via rclone ───────────────────────────────────────────
# Remote name configured in config/rclone/rclone.conf (see README).
RCLONE_REMOTE=gphotos
# Where files go inside the remote: "upload" = library, no album.
# Use e.g. "album/Backup HDD" to put everything in one album.
RCLONE_DEST_PATH=upload
# none | folder  (folder = album named after the file's relative folder)
GPHOTOS_ALBUM_MODE=none
# Extra flags appended to every rclone call, e.g. "--gphotos-client-id ..."
RCLONE_EXTRA_ARGS=
UPLOAD_TIMEOUT_MINUTES=120
UPLOAD_CONCURRENCY=1

# Bandwidth cap in megabit/s, applied with rclone --bwlimit (0 = unlimited).
MAX_UPLOAD_MBPS=20

# ── Retry ──────────────────────────────────────────────────────────────
# Exponential backoff: 30s → 60s → 120s → 240s … (capped at RETRY_MAX_SECONDS)
MAX_RETRIES=8
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=21600
# Pause after rclone config/auth errors (no retries are consumed).
CONFIG_ERROR_PAUSE_SECONDS=600

# ── Schedule ───────────────────────────────────────────────────────────
# Upload window (local time). Outside it files are queued but not uploaded.
# Empty = always. Windows crossing midnight (22:00 → 06:00) are supported.
SCHEDULE_START=02:00
SCHEDULE_END=07:00

LOG_LEVEL=info
